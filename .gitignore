__pycache__/
*.pyc
.venv/

# The database holds personal sleep data AND credentials (Oura OAuth tokens and
# client secret, the Claude API key in the settings table). Never committed;
# backup.sh / pull.sh keep the copies. Untracked on 2026-11-07 (older commits in
# this repo's history still carry it; origin never received it).
data/
*.db
*.db-shm
*.db-wal
backups/

# Claude Code local settings
.claude/settings.local.json

# macOS
.DS_Store

# Mac-side server address for pull.sh (see deploy/server.conf.example)
deploy/server.conf

# Per-machine config lives in ~/Library/Application Support/Sleep Bandit/config.env
config.env
node_modules/
dist/
build/

# iPhone app: generated project and build output (ios/build-ios.sh)
ios/*.xcodeproj
ios/SleepBandit/Info.plist

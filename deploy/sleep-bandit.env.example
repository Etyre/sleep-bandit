# /etc/sleep-bandit.env -- copy, fill in, chmod 600. Read by systemd (never commit the real one).
SB_PUBLIC=1
SB_HOST=127.0.0.1
SB_PORT=8777
SB_BASE_URL=https://elissleepbandit.com
# Unlinked admin path (choose something not guessable; letters/digits/dashes)
SB_ADMIN_PATH=admin-CHANGE-ME
# From:  python3 auth.py   (prompts for the password, prints this line)
SB_PASSWORD_HASH=

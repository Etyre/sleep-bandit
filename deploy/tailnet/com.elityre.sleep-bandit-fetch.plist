<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- While Sleep Bandit runs on the server, this keeps backups arriving on the Mac: once a day (and at login) it has
     the server take a fresh backup and copies it into backups/ here. Installed by deploy/tailnet/install-fetch.sh. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.elityre.sleep-bandit-fetch</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>__REPO__/deploy/tailnet/server.sh</string>
    <string>fetch</string>
    <string>--fresh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/sleep-bandit-fetch.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/sleep-bandit-fetch.log</string>
</dict></plist>

# ~/Library/Application Support/Sleep Bandit/config.env -- optional, per machine.
# KEY=VALUE lines read by server.py at startup; a variable already set in the
# environment (the launchd plist, your shell) wins. Install: copy this file there
# and edit; nothing is needed for the default local setup.
#SB_PORT=8777
#SB_HOST=127.0.0.1
#SB_DB_PATH=/Users/elityre/sleep-bandit/data/sleep_bandit.db
# Claude key for night-shape tags, if you prefer it here over the settings table
#ANTHROPIC_API_KEY=sk-ant-...
